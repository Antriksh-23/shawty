# ==============================================================================
# SHAWTY — ENVIRONMENT VARIABLE TEMPLATE
# Copy to .env.local and fill in real values. Never commit .env.local!
# ==============================================================================

# --- Supabase / Postgres ---
# Transaction-mode pooler (runtime app connections — pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (Prisma migrations only)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# --- Google Safe Browsing API ---
# Get a free key at https://developers.google.com/safe-browsing/v4/get-started
# If empty, the check is skipped (app works without it)
GOOGLE_SAFE_BROWSING_KEY=

# --- App base URL ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Security ---
AUTH_SECRET=your-32-character-random-secret-key-change-in-prod
IP_HASH_SALT=your-secret-pepper-for-gdpr-ip-hashing
BCRYPT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_ANON_MAX=20
RATE_LIMIT_WINDOW_SECONDS=3600

# --- CAPTCHA (optional) ---
CAPTCHA_ENABLED=false
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# --- Redis TTL for cached codes (seconds) ---
REDIS_CODE_TTL=86400
